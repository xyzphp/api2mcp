# Generated securely by: make init
ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN
# Keep this key with your database backup. Changing it makes existing data unreadable.
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY
PUBLIC_ORIGIN=http://localhost:8080
BASE_PATH=
APP_PORT=8080
BIND_ADDRESS=127.0.0.1
MOCK_PORT=9090
HTTP_ADDR=:8080
MOCK_ADDR=:9090
DATA_PATH=data/api2mcp.db
COOKIE_SECURE=false
SEED_MOCK=true
# Docker Compose overrides the Mock URL with the internal service address.
MOCK_API_URL=http://127.0.0.1:9090/v1
UPSTREAM_TIMEOUT_SECONDS=20
# Optional build proxy. Image pulls also need Docker Desktop / daemon proxy settings.
DOCKER_HTTP_PROXY=
DOCKER_HTTPS_PROXY=
DOCKER_ALL_PROXY=
GOPROXY=https://goproxy.cn,direct
